addr: :5000
# TLS listener on a separate port. Leave tls_addr empty to disable it.
tls_addr: ""       # e.g. ":5443"
tls_cert: ""       # path to PEM certificate, required when tls_addr is set
tls_key: ""        # path to PEM private key, required when tls_addr is set
logger: false
limit: 5000 # in KB/s
read_timeout: 30
write_timeout: 120
auth:
  enabled: false
  users:
    admin: 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9 # admin123 in sha256
ACL:
  default: permit
  permit:
  block:
    - example.com