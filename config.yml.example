addr: :5000
# TLS listener on a separate port. Leave tls_addr empty to disable it.
tls_addr: ""       # e.g. ":5443"
tls_cert: ""       # path to PEM certificate, required when tls_addr is set
tls_key: ""        # path to PEM private key, required when tls_addr is set
public_host: ""    # domain used in proxy.pac; empty = Host header of the request
logger: false
limit: 5000 # in KB/s
read_timeout: 30
idle_timeout: 300 # seconds without traffic before a tunnel is closed; 0 = never
write_timeout: 120
auth:
  enabled: false
  # Brute-force protection: block an IP after max_failures failed logins within
  # failure_window_minutes, for block_minutes.
  max_failures: 5
  failure_window_minutes: 15
  block_minutes: 15
  # Policy applied by cmd/hashpw when creating a password.
  password:
    min_length: 10
    require_upper: true
    require_digit: true
    require_symbol: true
  # enabled requires tls_addr; credentials are only accepted over TLS.
  # users: name: bcrypt hash (make one with: go run ./cmd/hashpw)
  users: {}
ACL:
  # Deny loopback, private, link-local and reserved addresses unless permitted by IP/CIDR.
  block_special_ranges: true
  default: permit
  permit:
  block:
    - example.com